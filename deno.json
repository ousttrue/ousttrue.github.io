{
  "tasks": {
    "dev": "deno run -A --node-modules-dir npm:vite",
    "build": "deno transpile src/*.tsx src/*.ts --outdir dist && deno run -A --node-modules-dir npm:vite build",
    "prerender": "deno -A prerender.ts",
    "preview": "deno run -A --node-modules-dir npm:vite preview"
  },
  "imports": {
    "@types/react": "npm:@types/react@^19.2.15",
    "react": "npm:react@^19.2.6",
    "react-dom": "npm:react-dom@^19.2.6",
    "remark": "npm:remark@^15.0.1",
    "remark-directive": "npm:remark-directive@^4.0.0",
    "remark-frontmatter": "npm:remark-frontmatter@^5.0.0",
    "remark-gfm": "npm:remark-gfm@^4.0.1",
    "shiki": "npm:shiki@^4.1.0",
    "tsc": "npm:tsc@^2.0.4",
    "yaml": "npm:yaml@^2.9.0",
  },
 "nodeModulesDir": "auto",
 "compilerOptions": {
     "types": [
         "react",
         "react-dom",
     ],
     "lib": [
         "dom",
         "dom.iterable",
         "deno.ns"
     ],
     "jsx": "react-jsx",
     "jsxImportSource": "react"
 } 
}
